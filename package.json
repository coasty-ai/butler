{
  "name": "coarena-open-assist",
  "version": "0.1.0",
  "private": true,
  "description": "Butler: a lightweight macOS terminal assistant with MCP tools, British conversation and proactive briefings.",
  "type": "module",
  "main": "dist-terminal/main.cjs",
  "scripts": {
    "dev": "npm run build:terminal && node dist-terminal/main.cjs",
    "build": "npm run build:terminal",
    "build:native": "node scripts/build-native.mjs",
    "start": "node dist-terminal/main.cjs",
    "start:local": "node dist-terminal/main.cjs",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "ingest": "tsx services/ingest/server.ts",
    "gym": "tsx src/gym/cli.ts",
    "format": "prettier --write src electron services tests scripts *.ts *.json",
    "test:native-safety": "node scripts/test-native-safety.mjs",
    "eval:dialog": "node --import tsx scripts/eval-dialog.mjs",
    "eval:jev": "node --import tsx scripts/eval-jev.mjs",
    "test:native-input": "node --import tsx scripts/native-input-smoke.mjs",
    "test:live": "node --import tsx scripts/live-task.mjs",
    "tools:check": "node --import tsx scripts/mcp-check.mjs",
    "bench": "node scripts/bench.mjs",
    "cycle": "node scripts/harness-cycle.mjs",
    "loop": "node scripts/harness-loop.mjs",
    "voice:loop": "node scripts/voice-loop.mjs",
    "analyze-runs": "node scripts/analyze-runs.mjs",
    "modules:check": "node scripts/modules-check.mjs",
    "observer:report": "node scripts/observer-report.mjs",
    "observer:eval": "node --import tsx scripts/observer-eval.mjs",
    "build:terminal": "tsc --noEmit && node scripts/build-terminal.mjs",
    "install:terminal": "node scripts/install-terminal.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "^8.20.0",
    "electron": "^41.10.7",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.46.0",
    "onnxruntime-common": "1.30.0",
    "prettier": "^3.9.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "optionalDependencies": {
    "onnxruntime-node": "1.30.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "bin": {
    "butler": "dist-terminal/main.cjs"
  }
}
